
@baseUrl = http://127.0.0.1:8000/api

### Register Farmer
POST {{baseUrl}}/auth/signup/
Content-Type: application/json

{
    "username": "raanu",
    "email": "shubh@example.com",
    "password": "Password@123"
}

### Login
POST {{baseUrl}}/auth/token/
Content-Type: application/json

{
    "username": "raanu",
    "password": "Password@123"
}

# Token Save Variable
@authToken = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ0b2tlbl90eXBlIjoiYWNjZXNzIiwiZXhwIjoxNzkyMTUwNTkwLCJpYXQiOjE3OTIwNjQxOTAsImp0aSI6ImM0YTllOWY2NjA1MTQ3NTlhOTQyZDNlNjFlYTA4MTcxIiwidXNlcl9pZCI6IjMifQ.bYAEo0rDd5J-_7mlGcsKjeAUuV9GNkexMJrtxI-cJMk
### 3. Get Authenticated Farmer Profile
GET {{baseUrl}}/auth/profile/
Authorization: Bearer {{authToken}}

### 4. Create New Land (Protected)
POST {{baseUrl}}/lands/
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "title": "Khet No 1 - Dhar Road",
    "khasra_number": "Khasra-402",
    "total_area_acres": "12.00",
    "soil_type": "Black Cotton",
    "water_source": "Borewell",
    "irrigation_type": "Drip"
}

### 5. Get All Lands
GET {{baseUrl}}/lands/
Authorization: Bearer {{authToken}}

